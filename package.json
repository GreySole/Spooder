{
  "name": "spooder",
  "version": "0.6.0",
  "description": "A LAN hosted Twitch companion that emits OSC from chat commands and Twitch events",
  "main": "spooder.ts",
  "workspaces": [
    "plugin-sdk",
    "src/integration/*"
  ],
  "scripts": {
    "start": "node --enable-source-maps dist/spooder.js",
    "dev": "tsx --enable-source-maps src/spooder.ts",
    "init": "tsx --enable-source-maps src/spooder.ts -i",
    "safe": "tsx --enable-source-maps src/spooder.ts -s",
    "prebuild": "node buildScripts/check-modules.js",
    "build": "tsc -p tsconfig.build.json && node buildScripts/copy-integration-manifests.js"
  },
  "author": "Grey Sole",
  "license": "GPL-3.0",
  "dependencies": {
    "@ngrok/ngrok": "^1.5.2",
    "@snazzah/davey": "^0.1.10",
    "@spooder/osc-js": "^2.4.6",
    "@vercel/ncc": "^0.38.3",
    "adm-zip": "^0.5.9",
    "buffer": "^6.0.3",
    "chmodr": "^1.2.0",
    "cookie-parser": "^1.4.6",
    "csstype": "^3.1.3",
    "eslint": "^9.33.0",
    "express": "^5.1.0",
    "fs-extra": "^11.3.1",
    "multer": "^2.0.2",
    "node-schedule": "^2.1.1",
    "prettier": "^3.3.2",
    "prettier-eslint": "^16.3.0",
    "spooder": "file:",
    "systeminformation": "^5.23.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/chmodr": "^1.0.3",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.2.0",
    "@types/node-schedule": "^2.1.8"
  }
}