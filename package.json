    "buffer": "^6.0.3",
    "chmodr": "^1.2.0",
    "cookie-parser": "^1.4.6",
    "csstype": "^3.1.3",
    "discord-rpc": "^4.0.1",
    "discord.js": "^14.7.1",
    "eslint": "^8.57.0",
    "express": "^4.18.1",
    "fs-extra": "^10.1.0",
    "googleapis": "^118.0.0",
    "multer": "^1.4.5-lts.1",
    "ngrok": "^5.0.0-beta.2",
    "obs-websocket-js": "^5.0.0",
