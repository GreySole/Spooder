  "main": "spooder.ts",
  "scripts": {
    "start": "node --enable-source-maps dist/spooder.js",
    "dev": "tsx --enable-source-maps src/spooder.ts",
    "init": "tsx --enable-source-maps src/spooder.ts -i",
    "safe": "tsx --enable-source-maps src/spooder.ts -s",
    "build": "tsc -p tsconfig.build.json"
  },
  "author": "Grey Sole",
  "license": "GPL-3.0",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@ngrok/ngrok": "^1.7.0",
    "@spooder/osc-js": "^2.4.7",
    "@vercel/ncc": "^0.38.4",
    "adm-zip": "^0.5.9",
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "chmodr": "^1.2.0",
    "cookie-parser": "^1.4.6",
    "csstype": "^3.2.3",
    "discord-rpc": "^4.0.1",
    "discord.js": "^14.25.1",
    "eslint": "^9.39.2",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "multer": "^2.0.2",
    "node-schedule": "^2.1.1",
    "obs-websocket-js": "^5.0.7",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.3.0",
    "spooder": "file:",
    "systeminformation": "^5.30.3",
    "tmi.js": "^1.8.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
